{
  "installCommand": "npm install --legacy-peer-deps --prefer-offline",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  }
}
